local currentTween = nil
local function smoothFlyTo(targetPos)
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local root = char:WaitForChild("HumanoidRootPart")
    if currentTween then currentTween:Cancel() end
    local distance = (root.Position - targetPos).Magnitude
    local speed = 150
    local duration = distance / speed
    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
    currentTween = TweenService:Create(root, tweenInfo, {CFrame = CFrame.new(targetPos)})
    currentTween:Play()
end

local function checkServerAndHop()
    local npcNames = {"Master of Auras", "Barista Cousin"}
    local found = false
    for _, name in pairs(npcNames) do
        if workspace:FindFirstChild(name) or (workspace:FindFirstChild("NPCs") and workspace.NPCs:FindFirstChild(name)) then
            found = true
            break
        end
    end
    if found then
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "NPC IS ACTIVE!",
            Text = "Tap locations to fly to them!",
            Duration = 10
        })
    else
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Scanning Area...",
            Text = "No NPC found. Hopping servers...",
            Duration = 3
        })
        task.wait(1)
        local sfUrl = "https://roblox.com" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
        local req = syn and syn.request or http_request or request or http.request
        if req then
            local res = req({Url = sfUrl, Method = "GET"})
            local data = HttpService:JSONDecode(res.Body)
            if data and data.data then
                for _, v in pairs(data.data) do
                    if v.playing < v.maxPlayers and v.id ~= game.JobId then
                        TeleportService:TeleportToPlaceInstance(game.PlaceId, v.id, LocalPlayer)
                        return
                    end
                end
            end
        end
        TeleportService:Teleport(game.PlaceId, LocalPlayer)
    end
end

